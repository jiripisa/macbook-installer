#!/bin/bash
# Fake curl: records the call. A *.tar.gz URL gets the file at $STUB_CURL_TARBALL;
# anything else (an installer piped into bash) gets the script in $STUB_CURL_BODY.
echo "curl $*" >> "$STUB_LOG"
case "${*: -1}" in
  *.tar.gz) cat "$STUB_CURL_TARBALL" ;;
  *) printf '%s\n' "${STUB_CURL_BODY:-true}" ;;
esac
